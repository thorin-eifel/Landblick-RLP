<?xml version="1.0" encoding="utf-8"?>
<!-- Artefakt-Konfiguration für SignPath (in SignPath unter Projekt → Artifact Configurations einfügen).
     Das Setup kommt als ZIP aus actions/upload-artifact; darin genau ein NSIS-Installer.
     Signiert wird nur das eigene Setup. pmtiles (go-pmtiles, Protomaps) ist ein Upstream-Programm und bleibt so, wie es geliefert wird.
     Die Produktversion bei der Einrichtung gegen die echten Metadaten des Setups prüfen und als product-version ergänzen. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Landblick - RLP_*_x64-setup.exe" product-name="Landblick - RLP">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
