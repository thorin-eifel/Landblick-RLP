<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd-Job: Probe für das Dauerlauf-Protokoll alle 10 Minuten (R6: 7 Tage ohne Handeingriff, Auswertung mit tools/dauerlauf.py report).
     Installation wie de.ctw.osint-cycle.plist (README, Abschnitt "Sammelstelle auf dem Mac"). Pfade anpassen. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>de.ctw.osint-dauerlauf</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/thorin/Claude/OSINT/.venv/bin/python</string>
    <string>tools/dauerlauf.py</string>
    <string>sample</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/thorin/Claude/OSINT</string>
  <key>StartInterval</key><integer>600</integer>
  <key>StandardOutPath</key><string>/Users/thorin/Library/Logs/osint-dauerlauf.log</string>
  <key>StandardErrorPath</key><string>/Users/thorin/Library/Logs/osint-dauerlauf.log</string>
</dict>
</plist>
