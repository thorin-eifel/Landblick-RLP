<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd-Job: Gesundheitsprüfung alle 10 Minuten (macOS-Pendant zu landblick-health.timer).
     Installation wie de.thorin.landblick-cycle.plist (README, Abschnitt "Sammelstelle auf dem Mac"). Pfade anpassen. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>de.thorin.landblick-health</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/thorin/Claude/Landblick/.venv/bin/python</string>
    <string>tools/gesundheit.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/thorin/Claude/Landblick</string>
  <key>StartInterval</key><integer>600</integer>
  <key>StandardOutPath</key><string>/Users/thorin/Library/Logs/landblick-health.log</string>
  <key>StandardErrorPath</key><string>/Users/thorin/Library/Logs/landblick-health.log</string>
</dict>
</plist>
