# Ein Sammeldurchlauf: abrufen, exportieren, hochladen (deploy/run-cycle.sh). Nur Linux mit systemd.
# Installation: siehe docs/betrieb.md, Abschnitt "Zeitplan mit systemd". Pfad /opt/osint und Benutzer osint anpassen.
[Unit]
Description=Landblick RLP: Sammeldurchlauf
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=osint
WorkingDirectory=/opt/osint
ExecStart=/opt/osint/deploy/run-cycle.sh
TimeoutStartSec=20min
Nice=10
# Härtung: der Sammler liest aus dem Netz und schreibt in data/ und web/data, sonst nirgends
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/osint/data /opt/osint/web/data
