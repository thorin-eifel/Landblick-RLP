# Ein Sammeldurchlauf: abrufen, exportieren, hochladen (deploy/run-cycle.sh). Nur Linux mit systemd.
# Installation: siehe docs/betrieb.md, Abschnitt "Zeitplan mit systemd". Pfad /opt/landblick und Benutzer landblick anpassen.
[Unit]
Description=Landblick RLP: Sammeldurchlauf
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=landblick
WorkingDirectory=/opt/landblick
ExecStart=/opt/landblick/deploy/run-cycle.sh
TimeoutStartSec=20min
Nice=10
# Härtung: der Sammler liest aus dem Netz und schreibt in data/ und web/data, sonst nirgends
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/landblick/data /opt/landblick/web/data
