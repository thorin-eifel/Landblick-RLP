# Tägliche Sicherung der Datenbank (tools/backup.py), danach Prüfsumme und Rückspielprobe der neuesten Sicherung.
[Unit]
Description=Landblick RLP: Datenbank sichern und Wiederherstellung prüfen

[Service]
Type=oneshot
User=landblick
WorkingDirectory=/opt/landblick
ExecStart=/opt/landblick/.venv/bin/python tools/backup.py --keep 14
ExecStart=/opt/landblick/.venv/bin/python tools/backup.py --verify
Nice=15
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/landblick/data
