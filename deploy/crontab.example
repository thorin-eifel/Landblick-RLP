# Sammelstelle (Linux oder macOS mit cron). Installation: crontab -e und die Zeilen anpassen.
# Pfad /opt/landblick durch den Projektordner ersetzen.
*/5 * * * *  /opt/landblick/deploy/run-cycle.sh >> /var/log/landblick-cycle.log 2>&1
15 3 * * *   cd /opt/landblick && .venv/bin/python tools/backup.py --keep 14 >> /var/log/landblick-backup.log 2>&1
# Logrotation für /var/log/landblick-*.log nicht vergessen (logrotate), sonst wächst die Datei ohne Ende.
