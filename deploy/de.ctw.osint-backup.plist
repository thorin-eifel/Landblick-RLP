<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd-Job: tägliche Sicherung mit Rückspielprobe (macOS-Pendant zu osint-backup.timer).
     Installation wie de.ctw.osint-cycle.plist (README, Abschnitt "Sammelstelle auf dem Mac"). Pfade anpassen. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>de.ctw.osint-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>.venv/bin/python tools/backup.py --keep 14 &amp;&amp; .venv/bin/python tools/backup.py --verify</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/thorin/Claude/OSINT</string>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>15</integer></dict>
  <key>StandardOutPath</key><string>/Users/thorin/Library/Logs/osint-backup.log</string>
  <key>StandardErrorPath</key><string>/Users/thorin/Library/Logs/osint-backup.log</string>
</dict>
</plist>
